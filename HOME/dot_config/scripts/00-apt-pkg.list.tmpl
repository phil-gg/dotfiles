{{- /* Package list replacement for sudo apt build-dep -y mesa/trixie-backports */}}
{{ output "bash" "-c" `\
apt-cache showsrc mesa 2>/dev/null | awk -v target="$(
apt-cache madison mesa | awk '/trixie-backports.*Sources/ {print $3}' |
sort -V | tail -n 1)" '
BEGIN { RS=""; FS="\n" }
{
    ver = ""
    output = ""
    collect = 0
    for (i=1; i<=NF; i++) {
        if ($i ~ /^Version:[ \t]*/) {
            ver = $i
            sub(/^Version:[ \t]*/, "", ver)
        }
        if ($i ~ /^Build-Depends(-[A-Za-z]+)?:/) {
            collect = 1
            output = output (output ? "\n" : "") $i
            continue
        }
        if (collect) {
            if ($i ~ /^[ \t]/) {
                output = output "\n" $i
            } else {
                collect = 0
            }
        }
    }
    if (ver == target) {
        print output
        exit
    }
}
' | \
sed 's/^Build-Depends[-A-Za-z]*: //' | \
tr ',' '\n' | \
sed -e 's/ ([^)]*)//g' -e 's/ \[[^]]*\]//g' -e 's/ <[^>]*>//g' | \
awk -F'|' '{print $1}' | \
tr -d ' ' | \
sed 's/^debhelper-compat$/debhelper/' | \
sort -u
` -}}
